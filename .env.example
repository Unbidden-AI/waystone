# Copy this file to .env and fill in your values. .env is gitignored.
#
# ════════════════════════════════════════════════════════════════════════════
#  SELF-HOSTED TEAM SERVER  —  this is what you need if you bought a license.
#  `docker compose up -d` runs Postgres (pgvector) + the API. Fill in the few
#  values below; everything else has a sane default.
# ════════════════════════════════════════════════════════════════════════════

# ── 1. Auth: choose ONE ──────────────────────────────────────────────────────
# (A) You bought a license → paste the token from your purchase email. This
#     auto-enables per-seat mode; issue each teammate a key afterwards with:
#         docker compose exec server waystone team issue teammate@acme.com
WAYSTONE_LICENSE=
#     (or point at a file instead of pasting:)
# WAYSTONE_LICENSE_FILE=/run/secrets/waystone_license

# (B) Just want one shared key for the whole team → leave WAYSTONE_LICENSE blank
#     and set a strong random string here instead. Generate one with:
#         python -c "import secrets; print('waystone_'+secrets.token_urlsafe(32))"
WAYSTONE_API_KEY=

# ── 2. Extraction LLM the SERVER calls (OpenAI-compatible) ───────────────────
# Defaults target Gemini 2.5 Flash. Get a key at aistudio.google.com.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash

# ── 3. Infra (defaults are fine on a private network) ────────────────────────
# Avoid @ : / in the password — it goes into the DATABASE_URL DSN unencoded.
POSTGRES_USER=waystone
POSTGRES_PASSWORD=waystone
POSTGRES_DB=waystone
WAYSTONE_PORT=8000
# Force an auth mode explicitly if you ever need to (a license already implies 1):
# CB_USE_ADMIN_DB=1

# Point each teammate's client at the server (in their ~/.waystone/config.yaml):
#   backend: remote
#   api_url: http://<server-host>:8000
#   api_key: <their per-seat key, or the shared WAYSTONE_API_KEY>


# ════════════════════════════════════════════════════════════════════════════
#  BILLING SERVER (Unbidden-internal)  —  IGNORE THIS unless you operate the
#  hosted SaaS / license-sales API. Self-hosted customers do NOT need any of it.
# ════════════════════════════════════════════════════════════════════════════
# CB_USE_ADMIN_DB=1                       # tier enforcement + billing
# STRIPE_WEBHOOK_SECRET=whsec_...         # Stripe dashboard → Webhooks
# STRIPE_PRO_PRICE_ID=price_...           # hosted Pro/Team API-key tiers
# STRIPE_TEAM_PRICE_ID=price_...
# STRIPE_TEAM_LICENSE_PRICE_ID=price_...  # self-hosted license product (seats = qty)
# WAYSTONE_LICENSE_PRIVKEY=               # Ed25519 PEM that mints licenses on purchase
# WAYSTONE_LICENSE_PRIVKEY_FILE=/run/secrets/waystone_license_key.pem
# RESEND_API_KEY=re_...                   # delivers keys/licenses by email (resend.com)
