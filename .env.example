# Project-local environment variables for Engram.
# Copy this file to .env and fill in your values.
# .env is gitignored — safe for API keys.

# ── LLM provider ────────────────────────────────────────────────────────────
# API key for extraction / reflection (Gemini recommended).
GEMINI_API_KEY=your_gemini_key_here

# ── Monetization (required when running the hosted API) ─────────────────────
# Set CB_USE_ADMIN_DB=1 to enable tier enforcement and billing.
# When unset, ALL node limits are bypassed — appropriate for self-hosted
# single-user installs, but must NOT be omitted in production.
CB_USE_ADMIN_DB=1

# Secret used to authenticate inbound REST API requests (admin / server-to-server).
CB_API_KEY=your_admin_secret_here

# LemonSqueezy webhook signing secret (from your LS dashboard → Webhooks).
# If unset while CB_USE_ADMIN_DB=1, webhooks are rejected and customers who
# pay will not receive API keys.
LS_WEBHOOK_SECRET=your_ls_webhook_secret_here

# LemonSqueezy variant IDs for each paid plan (from your LS dashboard → Products).
LS_PRO_VARIANT_ID=123456
LS_TEAM_VARIANT_ID=123457

# ── Email delivery ───────────────────────────────────────────────────────────
# Resend API key for delivering customer API keys by email.
# Sign up at resend.com and verify your sending domain (unbidden.ai).
RESEND_API_KEY=your_resend_key_here

# ── Self-hosted Team Server (docker-compose.yml) ─────────────────────────────
# `docker compose up` runs Postgres (pgvector) + the API. Set these, then point
# teammates' clients at it with  backend: remote / api_url / api_key.
#
# Shared API key teammates authenticate with (any strong random string):
#   python -c "import secrets; print('waystone_'+secrets.token_urlsafe(32))"
WAYSTONE_API_KEY=
# Extraction LLM the SERVER calls (OpenAI-compatible). Defaults target Gemini.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
# Postgres creds (defaults are fine on a private network) + exposed host port.
# Avoid @ : / in the password — it goes into the DATABASE_URL DSN unencoded.
POSTGRES_USER=waystone
POSTGRES_PASSWORD=waystone
POSTGRES_DB=waystone
WAYSTONE_PORT=8000
