# Waystone Team Server — fill these in, save as `.env` next to docker-compose.yml.

# ── Auth: choose ONE ─────────────────────────────────────────────────────────
# (A) You bought a license → paste the token from your purchase email. This
#     auto-enables per-seat mode; after `docker compose up -d`, issue keys with:
#         docker compose exec server waystone team issue teammate@acme.com
WAYSTONE_LICENSE=

# (B) Or just one shared key for everyone (leave WAYSTONE_LICENSE blank). Make one:
#         python -c "import secrets; print('waystone_'+secrets.token_urlsafe(32))"
WAYSTONE_API_KEY=

# ── Extraction LLM the server calls (OpenAI-compatible; default = Gemini) ────
# Get a key at aistudio.google.com.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash

# ── Optional infra (defaults are fine on a private network) ─────────────────
# Pin a specific server version instead of :latest —
# WAYSTONE_IMAGE=ghcr.io/unbidden-ai/waystone-server:0.4.37
WAYSTONE_PORT=8000
POSTGRES_USER=waystone
POSTGRES_PASSWORD=waystone
POSTGRES_DB=waystone
